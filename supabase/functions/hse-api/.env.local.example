# انسخ إلى .env.local في نفس المجلد (مستبعد عن Git).
# على Supabase المستضاف: الدالة تقرأ SUPABASE_DB_URL تلقائياً (لا حاجة لسر يدوي عادة).
# للتطوير المحلي فقط — من Settings → Database → Connection string (URI).
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# اختياري: من Settings → API → service_role (للاستخدام داخل الدالة فقط، لا للمتصفح)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

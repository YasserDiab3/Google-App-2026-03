{
  "name": "clinic-repo",
  "private": true,
  "description": "HSE clinic-repo root tooling (Playwright smoke + shared scripts)",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:p3:parity": "node tools/p3-parity-selftest.js",
    "test:p3:guards": "node tools/p3-security-guards-selftest.js",
    "test:p3": "node tools/p3-parity-selftest.js && node tools/p3-security-guards-selftest.js",
    "test:gates": "npm run test:p3 && npm run test:e2e:smoke"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0"
  }
}

{
  "buildCommand": "npm run build",
  "installCommand": "npm install --no-audit --no-fund && npm install oracledb@6.10.0 --no-audit --no-fund",
  "outputDirectory": "dist",
  "functions": {
    "api/exec.js": {
      "maxDuration": 60,
      "includeFiles": "{api/_oci-proxy.js,backend-sql/data/clinic_hse.db.gz,node_modules/oracledb/**,node_modules/deasync/**}",
      "excludeFiles": "{**/*.db,**/*.db-wal,**/*.db-shm,**/*.rebuilt.db,**/backups/**}"
    },
    "api/health.js": {
      "maxDuration": 60,
      "includeFiles": "api/_oci-proxy.js"
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "safetyicapp-ecru.vercel.app" }],
      "destination": "https://www.safety-icapp.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "safety-icapp.com" }],
      "destination": "https://www.safety-icapp.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/manifest-visitor.json",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/version.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate, no-cache" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate, no-cache" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate, no-cache" }]
    },
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate, no-cache" }]
    },
    {
      "source": "/icons/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*).js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(.*).css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ],
  "rewrites": [
    { "source": "/exec", "destination": "/api/exec" },
    { "source": "/forms", "destination": "/forms-hub.html" },
    { "source": "/forms-hub", "destination": "/forms-hub.html" },
    { "source": "/gate", "destination": "/gate-visitor-entry.html" },
    { "source": "/visitors", "destination": "/gate-visitor-entry.html" },
    { "source": "/gate-visitor-entry", "destination": "/gate-visitor-entry.html" },
    { "source": "/obs", "destination": "/public-observation.html" },
    { "source": "/observation", "destination": "/public-observation.html" },
    { "source": "/near-miss", "destination": "/public-near-miss.html" },
    { "source": "/fire", "destination": "/public-fire-inspection.html" },
    { "source": "/fire-inspection", "destination": "/public-fire-inspection.html" },
    { "source": "/daily-safety", "destination": "/public-daily-safety.html" },
    { "source": "/patrol", "destination": "/public-daily-safety.html" }
  ]
}

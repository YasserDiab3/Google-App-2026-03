# Normalize line endings to LF in the repository; checkout as-is on all platforms
* text=auto eol=lf

# Force binary files to not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
*.zip binary
